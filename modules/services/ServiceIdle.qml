pragma Singleton
pragma ComponentBehavior: Bound

import Quickshell
import Quickshell.Io
import QtQuick
import qs.modules.settings

// Owns ~/.config/hypr/hypridle.conf: the settings page edits timeouts, this
// regenerates the file and restarts hypridle so the change takes effect now
// rather than at next login.
//
// The file is generated wholesale rather than patched, because hypridle has no
// include mechanism to keep hand-written and generated parts apart. A one-time
// backup is taken the first time this writes, so the original hand-tuned config
// is always recoverable from hypridle.conf.bak.
Singleton {
    id: root

    readonly property string confPath: Quickshell.env("HOME") + "/.config/hypr/hypridle.conf"
    readonly property string backupPath: root.confPath + ".bak"

    readonly property var cfg: SettingsConfig.sleep

    // Minutes in settings; hypridle wants seconds
    function _secs(min) { return Math.max(1, Math.round((min ?? 1) * 60)) }

    function buildConf() {
        var out = ""
        out += "# Generated by quickshell — Settings › Sleep\n"
        out += "# Hand edits here are overwritten. Original saved as hypridle.conf.bak\n\n"

        out += "general {\n"
        out += "    lock_cmd = hyprctl dispatch 'hl.dsp.global(\"quickshell:lock\")'\n"
        out += "    before_sleep_cmd = loginctl lock-session\n"
        out += "    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })'\n"
        out += "}\n"

        if (root.cfg?.dimEnabled ?? true) {
            out += "\n# Dim the backlight\n"
            out += "listener {\n"
            out += "    timeout = " + root._secs(root.cfg?.dimMinutes) + "\n"
            out += "    on-timeout = brightnessctl -s set " + (root.cfg?.dimLevel ?? 10) + "\n"
            out += "    on-resume = brightnessctl -r\n"
            out += "}\n"
        }

        if (root.cfg?.lockEnabled ?? true) {
            out += "\n# Lock the session\n"
            out += "listener {\n"
            out += "    timeout = " + root._secs(root.cfg?.lockMinutes) + "\n"
            out += "    on-timeout = loginctl lock-session\n"
            out += "}\n"
        }

        if (root.cfg?.screenOffEnabled ?? false) {
            out += "\n# Turn the display off\n"
            out += "listener {\n"
            out += "    timeout = " + root._secs(root.cfg?.screenOffMinutes) + "\n"
            out += "    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = \"disable\" })'\n"
            out += "    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = \"enable\" })' && brightnessctl -r\n"
            out += "}\n"
        }

        if (root.cfg?.suspendEnabled ?? true) {
            out += "\n# Suspend\n"
            out += "listener {\n"
            out += "    timeout = " + root._secs(root.cfg?.suspendMinutes) + "\n"
            out += "    on-timeout = systemctl suspend\n"
            out += "}\n"
        }

        return out
    }

    // ── Write + reload ────────────────────────────────────────────────
    FileView {
        id: confFile
        path: root.confPath
        printErrors: true
        onSaved: restartTimer.restart()
    }

    property bool backedUp: false

    function apply() {
        if (root.backedUp)
            confFile.setText(root.buildConf())
        else if (!backupProc.running)
            backupProc.running = true
    }

    Process {
        id: backupProc
        command: ["sh", "-c", "cp -n \"$0\" \"$1\" 2>/dev/null || true", root.confPath, root.backupPath]
        onExited: {
            root.backedUp = true
            confFile.setText(root.buildConf())
        }
    }

    Timer {
        id: restartTimer
        interval: 50
        repeat: false
        onTriggered: Quickshell.execDetached(["sh", "-c",
            "pkill -x hypridle; sleep 0.2; hypridle & disown"])
    }

    // Debounced so dragging a spin box doesn't restart hypridle per step
    Timer {
        id: debounce
        interval: 700
        repeat: false
        onTriggered: root.apply()
    }

    // Deliberately not applied on startup — that would rewrite the user's
    // config just because the shell launched. Only an actual settings change
    // regenerates the file.
    property bool _armed: false
    onCfgChanged: {
        if (!root._armed) { root._armed = true; return }
        debounce.restart()
    }
}
